{
  "description": "Deterministic PreToolUse/PostToolUse gates wiring this repository's own hook scripts to Claude Code tool-call matchers, plus a SessionStart entry injecting gitapex's own skill-invocation discipline. Each gate's own rationale, tracking issue, and enforced rule live in .gitapex/ssot.json's gates[] registry (match on the trigger field naming this file) -- not duplicated here.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gitapex-session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-bash-safety.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-template-overwrite.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(github|plugin_github_github)__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-issue-acm-disclosure.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-gate-proposal-dedup-sweep.sh\"",
            "timeout": 130
          }
        ]
      },
      {
        "matcher": "mcp__(github|plugin_github_github)__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-upstream-pushed.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-skill-audit-disclosure.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-body-preflight.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-issue-acm-disclosure.sh\"",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-title-convention.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-duplicate-issue.sh\"",
            "timeout": 130
          }
        ]
      },
      {
        "matcher": "mcp__(github|plugin_github_github)__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-skill-audit-disclosure.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-body-preflight.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-title-convention.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(github|plugin_github_github)__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-merge-pull-request-block.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__plugin_github_github__create_pull_request|mcp__github__update_pull_request|mcp__plugin_github_github__update_pull_request|mcp__github__issue_write|mcp__plugin_github_github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-post-write-provenance.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|mcp__(github|plugin_github_github)__resolve_review_thread|mcp__(github|plugin_github_github)__pull_request_read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-post-review-obligation-tracker.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-stop-review-obligation.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
