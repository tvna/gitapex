{
  "description": "Deterministic PreToolUse/PostToolUse gates wiring this repository's own hook scripts to Claude Code tool-call matchers. Each gate's own rationale, tracking issue, and enforced rule live in .gitapex/ssot.json's gates[] registry (match on the trigger field naming this file) -- not duplicated here.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-bash-safety.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-template-overwrite.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-issue-acm-disclosure.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-upstream-pushed.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-skill-audit-disclosure.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-issue-acm-disclosure.sh\"",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-title-convention.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-skill-audit-disclosure.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-title-convention.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-merge-pull-request-block.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/check-post-write-provenance.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
