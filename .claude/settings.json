{
  "extraKnownMarketplaces": {
    "gitapex": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "gitapex@gitapex": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "async": false,
            "command": "\".claude/hooks/clairvoyance/hooks/run-hook.cmd\" session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "async": false,
            "command": "\".claude/hooks/clairvoyance/hooks/run-hook.cmd\" user-prompt-language.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "async": false,
            "command": "\".claude/hooks/clairvoyance/hooks/run-hook.cmd\" workflow-budget-gate.sh"
          }
        ]
      }
    ]
  }
}
